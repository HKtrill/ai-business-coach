# ----------------------
# Notebook model artifacts 
# ----------------------
# Match by extension only: models/ folders also contain source packages.
**/models/**/*.joblib
**/models/**/*.pkl
**/models/**/*.json
# PR 37: immutable versions of fixed-name artifacts (<stem>_<YYYYMMDD_HHMMSS_ffffff>_*.csv)
# and preserved pre-PR 37 files; only the latest-alias CSVs (<stem>_*.csv) are tracked.
**/models/**/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]_*.csv
**/models/**/*_preserved_*.csv

# ----------------------
# Jupyter / test caches
# ----------------------
.ipynb_checkpoints/
.pytest_cache/

# ----------------------
# Data / DB
# ----------------------
/prototype/bank_pipeline/data/db/

# ----------------------
# Executed notebooks and their archives (PR 42, Step 6B)
# ----------------------
# Executed copies, archives and preserved outputs are written outside the repository
# (notebook_packaging refuses paths inside it). These rules keep any copy placed here by
# hand out of Git; the archives are published as GitHub release assets instead.
*_executed.ipynb
*_input.ipynb
executed_notebooks.zip
*_executed_notebooks.zip
*_executed_notebooks/
*_tracked_outputs.ipynb
